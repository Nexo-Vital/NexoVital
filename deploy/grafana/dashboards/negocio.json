  "description": "Escenario O-1 (EP-06.F5.US3). Los valores salen de la base de datos (T43): las dos instancias publican el mismo número y se combinan con max().",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
