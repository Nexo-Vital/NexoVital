  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Usuarios activos",
      "datasource": {
        "type": "prometheus",
        "uid": "nexovital-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexovital-prometheus"
          },
          "expr": "sum(nexovital_usuarios_stomp)",
          "legendFormat": "sesiones",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Sesiones autenticadas abiertas en el canal en tiempo real, sumando las dos instancias."
