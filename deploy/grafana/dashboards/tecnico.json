    },
    {
      "id": 7,
      "type": "stat",
      "title": "Errores 5xx (últimos 5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "nexovital-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexovital-prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "errores",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errores 5xx por minuto",
      "datasource": {
        "type": "prometheus",
