          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexovital-prometheus"
          },
          "expr": "sum(nexovital_usuarios_stomp)",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nexovital-prometheus"
          },
          "expr": "sum by (instancia) (nexovital_usuarios_stomp)",
          "legendFormat": "{{instancia}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU del proceso",
      "datasource": {
        "type": "prometheus",
        "uid": "nexovital-prometheus"
      },
      "gridPos": {
        "h": 7,
