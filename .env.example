# ==========================================================================
# Variables de docker-compose.yml.
#
# ==========================================================================

# Contrasena del PostgreSQL local. Cualquier texto sin espacios ni simbolos raros.
POSTGRES_PASSWORD=cambia-esta-contrasena

# Secreto JWT (opcional en local). Si se deja vacio, el back genera uno nuevo en
# cada arranque y las sesiones abiertas se cierran al reiniciar el contenedor.
NEXOVITAL_JWT_SECRET=
