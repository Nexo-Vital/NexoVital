# Normalize line endings on commit/checkout.
* text=auto eol=lf

# PowerShell scripts keep CRLF for Windows PowerShell 5.1 compatibility.
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Text sources and configs.
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.json text
*.jsonc text
*.css text
*.html text
*.yml text
*.yaml text
*.md text eol=lf
*.svg text eol=lf

# Binary assets: never convert, never text-diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
